# --- Servidor ---------------------------------------------------------------
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
# URL pública HTTPS do bot (obrigatória para webhooks em produção)
PUBLIC_URL=

# --- Supabase (service_role: só no servidor, nunca no browser) ---------------
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM ---------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Só para modelos gpt-5*: none | minimal | low | medium | high
OPENAI_REASONING_EFFORT=none

# --- Pedido por áudio (transcrição com a mesma chave da OpenAI) ----------------------
TRANSCRICAO_AUDIO=true
# whisper-1 | gpt-4o-mini-transcribe | gpt-4o-transcribe
OPENAI_TRANSCRICAO_MODELO=whisper-1
# Áudios mais longos que isso pedem para o cliente escrever ou mandar mais curto
AUDIO_DURACAO_MAXIMA_SEGUNDOS=180

# --- Agente ------------------------------------------------------------------
# Link do cardápio público que o bot envia (ex.: https://painel.SEU-DOMINIO/cardapio).
# Teste local pelo celular: use http://<IP-do-PC>.nip.io:3000/cardapio — o WhatsApp
# não deixa clicável link com IP puro.
CARDAPIO_URL=
# Pedido pelo link: base do link de acompanhamento no WhatsApp (padrão: CARDAPIO_URL trocando /cardapio por /pedir)
# PEDIR_URL=https://painel.seudominio.com.br/pedir
# Conversa parada há mais que isso recomeça do zero
CONVERSA_EXPIRACAO_MINUTOS=180
# Máximo de mensagens do histórico enviadas ao modelo
HISTORICO_LIMITE=40

# --- Pix simulado (sem dinheiro de verdade) ---------------------------------------
# O bot faz o papel do banco: gera QR e copia e cola no padrão do Banco Central,
# expira, estorna e confirma por webhook assinado. Para "pagar", use o painel:
# Configurações > Banco simulado (cole o copia e cola, como no app do banco).
PIX_SIMULADO=true
# Chave aleatória fictícia (um app de banco real não acha a chave e não deixa pagar)
# PIX_SIMULADO_CHAVE=7d9f0335-8dcc-4054-9bf9-0dbd61d36906
PIX_SIMULADO_CIDADE=SAO PAULO
# Segredo do HMAC dos webhooks (opcional; sem ele, um aleatório a cada início)
# PIX_SIMULADO_SEGREDO=
# Descarta webhooks de propósito (0 a 1) para testar a conferência periódica
PIX_SIMULADO_PERDA_WEBHOOK=0
# Conferência periódica dos Pix pendentes (cobre webhook perdido e expira vencidos)
PIX_CONFERENCIA_SEGUNDOS=60

# --- WhatsApp (Evolution API) --------------------------------------------------------
WHATSAPP_ENABLED=true
# No docker-compose: http://evolution:8080
EVOLUTION_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCIA=vianna
# Token longo e aleatório (openssl rand -hex 24). Webhook na Evolution:
# <PUBLIC_URL>/webhooks/whatsapp/<WHATSAPP_WEBHOOK_TOKEN>  (evento MESSAGES_UPSERT)
WHATSAPP_WEBHOOK_TOKEN=
