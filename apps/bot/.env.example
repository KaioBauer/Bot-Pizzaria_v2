# --- Servidor ---------------------------------------------------------------
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
# URL pública HTTPS do bot (obrigatória para webhooks em produção)
PUBLIC_URL=

# --- Supabase (service_role: só no servidor, nunca no browser) ---------------
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM ---------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Só para modelos gpt-5*: none | minimal | low | medium | high
OPENAI_REASONING_EFFORT=none

# --- Agente ------------------------------------------------------------------
# Conversa parada há mais que isso recomeça do zero
CONVERSA_EXPIRACAO_MINUTOS=180
# Máximo de mensagens do histórico enviadas ao modelo
HISTORICO_LIMITE=40

# --- Telegram (criar o bot com @BotFather) -----------------------------------
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
# polling em desenvolvimento; webhook em produção (exige PUBLIC_URL)
TELEGRAM_MODE=polling
# Segredo aleatório validado em cada chamada do webhook (ex.: openssl rand -hex 32)
TELEGRAM_WEBHOOK_SECRET=

# --- Pix (Mercado Pago) ----------------------------------------------------------
# Pix online liga sozinho quando o token existe. Credenciais em
# https://www.mercadopago.com.br/developers/panel > Suas integrações
MP_ACCESS_TOKEN=
# Segredo da assinatura (Suas integrações > Webhooks). Obrigatório em produção.
# Webhook a cadastrar no painel do MP: <PUBLIC_URL>/webhooks/mercadopago (evento "Pagamentos")
MP_WEBHOOK_SECRET=
# A API exige um e-mail de pagador; o cliente não precisa informar o dele
MP_EMAIL_PAGADOR=pagamentos@viannapizzaria.com.br
# Conferência periódica dos Pix pendentes (cobre webhook perdido e expira vencidos)
PIX_CONFERENCIA_SEGUNDOS=60

# --- WhatsApp (Evolution API) --------------------------------------------------------
WHATSAPP_ENABLED=false
# No docker-compose: http://evolution:8080
EVOLUTION_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCIA=vianna
# Token longo e aleatório (openssl rand -hex 24). Webhook na Evolution:
# <PUBLIC_URL>/webhooks/whatsapp/<WHATSAPP_WEBHOOK_TOKEN>  (evento MESSAGES_UPSERT)
WHATSAPP_WEBHOOK_TOKEN=
