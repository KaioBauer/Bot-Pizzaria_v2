NODE_ENV=production
LOG_LEVEL=info

# --- Supabase ------------------------------------------------------------------
# Chave anon (pública). O acesso vem do login do usuário "impressora", com RLS:
# este PC NUNCA recebe a service_role. Gerar com: pnpm usuario impressora
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
IMPRESSORA_EMAIL=
IMPRESSORA_SENHA=

# --- Impressora ------------------------------------------------------------------
# windows:NOME  -> impressora instalada no Windows (USB), nome como aparece em
#                  "Impressoras e scanners" (PowerShell: Get-Printer)
# tcp://IP:9100 -> impressora de rede
PRINTER_INTERFACE=windows:POS-58
# 58 (32 colunas) ou 80 (48 colunas); PRINTER_COLUNAS sobrescreve
PRINTER_LARGURA_MM=58
# epson | elgin | bematech | star | generico (todas exceto star usam ESC/POS Epson)
PRINTER_MODELO=generico
# Acentos: PC860_PORTUGUESE | PC850_MULTILINGUAL | WPC1252 | nenhuma (remove acentos)
PRINTER_PAGINA_CODIGO=PC860_PORTUGUESE
# Linhas em branco antes do corte
PRINTER_AVANCO_CORTE=3
PRINTER_VIAS=1

# Conferência periódica da fila (segundos), além do tempo real
VARREDURA_SEGUNDOS=30

# Endereço público do painel (ex.: https://painel.vianna.com.br). Com ele, o cupom de
# entrega sai com um QR para o motoboy iniciar e confirmar a entrega pelo celular.
PAINEL_URL=
