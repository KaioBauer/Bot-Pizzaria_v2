{
  "name": "@pizzaria/print-agent",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "servico:instalar": "pnpm build && tsx scripts/servico.ts instalar",
    "servico:remover": "tsx scripts/servico.ts remover"
  },
  "dependencies": {
    "@pizzaria/db": "workspace:*",
    "@pizzaria/shared": "workspace:*",
    "node-thermal-printer": "^4.4.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5",
    "@supabase/supabase-js": "^2.117.2"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "node-windows": "^1.0.0-beta.8"
  }
}
