# Painel + cardápio público. O web usa SÓ a chave anon: todo acesso do painel
# passa pelo login do usuário admin e pelo RLS (não há service_role aqui).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Endereço interno do bot (só o servidor do painel usa, para conectar o WhatsApp
# pela tela Configurações). Local: http://localhost:3001 · docker-compose: http://bot:3001
BOT_URL=http://localhost:3001
