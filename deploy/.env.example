# Variáveis do docker-compose: copie para .env na RAIZ do repositório.
# As variáveis do bot ficam em apps/bot/.env.

# Embutidas no build do painel/cardápio (públicas: chave ANON, nunca a service_role)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- WhatsApp (só com --profile whatsapp) ---
# Mesmos valores de EVOLUTION_API_KEY e WHATSAPP_WEBHOOK_TOKEN do apps/bot/.env
# (gere com: openssl rand -hex 24)
EVOLUTION_API_KEY=
WHATSAPP_WEBHOOK_TOKEN=
EVOLUTION_DB_PASSWORD=
# URL pela qual você acessa a Evolution (com túnel SSH: http://localhost:8080)
EVOLUTION_SERVER_URL=http://localhost:8080
